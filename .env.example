# Supabase project settings (Project Settings → API).
# Only the public anon key belongs here. NEVER put the service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Leave both blank to run in local demo mode (fictional data stored in your browser).
# Set to "true" only when hosting somewhere that cannot rewrite routes to index.html.
VITE_HASH_ROUTER=false

# Set to "false" in production so a missing Supabase config shows an error instead of demo mode.
VITE_ALLOW_DEMO=true
