{
  "name": "campusfix",
  "private": true,
  "version": "0.1.0",
  "description": "CampusFix \u2014 See it. Report it. Fix it. Get rewarded.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "tsx --test src/lib/*.test.ts",
    "test:db": "node tests/db.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:db && npm run test:e2e",
    "db:seed": "tsx scripts/generate-seed.ts",
    "db:bundle": "npm run db:seed && node scripts/bundle-setup-sql.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "lucide-react": "^0.475.0",
    "maplibre-gl": "6.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vite": "^6.1.0"
  }
}
